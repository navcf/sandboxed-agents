#!/usr/bin/env sh
# Launch an agent sandbox preloaded with a GitHub issue or PR as context.
#
# Fetches the item with `gh` (title, body, labels, comments; diff stat for
# PRs), writes it to <workspace>/.local/sbx-context/<issue|pr>-<id>.md, and
# runs `sbx run --clone --name <agent>-<id>` from the current directory with
# an initial prompt that points the agent at the context file. The workspace
# mounts at the same absolute path inside the sandbox (read-only in --clone
# mode), so the file is reachable either way; `.local/` is typically
# gitignored, so the context file never dirties the workspace's git status.
#
# Usage: sbx-issue [--repo owner/name] [--no-clone] AGENT ISSUE_OR_PR [SBX_RUN_FLAGS...]
set -eu

usage() {
  cat <<'EOF'
usage: sbx-issue [--repo owner/name] [--no-clone] AGENT ISSUE_OR_PR [SBX_RUN_FLAGS...]

Run from the workspace directory. Fetches a GitHub issue or PR and launches
`sbx run` with the sandbox named <AGENT>-<id> and the item preloaded as
context.

  AGENT           claude | codex | cursor (get this repo's baked template and
                  --no-share-skills automatically) or any other sbx agent
  ISSUE_OR_PR     issue/PR number, or a full https://github.com/... URL
  --repo          owner/name to fetch from (default: the current repo's
                  origin, or the repo in the URL)
  --no-clone      work directly on the host working tree (default is --clone:
                  the agent gets a private clone; sync with sbx-git)
  SBX_RUN_FLAGS   passed through to `sbx run` (e.g. -t IMAGE)

defaults, applied at sandbox creation:
  --clone, and for claude/codex/cursor also --no-share-skills + the baked
  template (your own -t wins). Extra dirs are mounted when they exist:
  $SBX_ISSUE_NOTES_DIR (default /Users/nav/Documents/Notes; set it empty to
  skip) and ~/.ssh/sandbox:ro (GitHub SSH key — see README "GitHub over SSH").

examples:
  sbx-issue cursor 1234                 # sandbox cursor-1234, issue #1234
  sbx-issue claude 88 --no-clone        # bind-mount sandbox claude-88
  sbx-issue --repo acme/api codex https://github.com/acme/api/pull/42

Re-running with the same AGENT and id re-attaches to the existing sandbox
(creation flags are ignored then) and re-sends the initial prompt.
EOF
}

die() { echo "sbx-issue: $*" >&2; exit 1; }

repo= clone=1
while [ $# -gt 0 ]; do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --repo) [ $# -ge 2 ] || die "--repo needs an argument"; repo=$2; shift 2 ;;
    --repo=*) repo=${1#--repo=}; shift ;;
    --no-clone) clone=; shift ;;
    *) break ;;
  esac
done
[ $# -ge 2 ] || { usage >&2; exit 2; }
agent=$1 ref=$2
shift 2
# Everything left in "$@" is passed through to `sbx run`.

command -v gh >/dev/null 2>&1 || die "gh CLI not found — install it (https://cli.github.com) and run 'gh auth login'"
gh auth status >/dev/null 2>&1 || die "gh is not authenticated — run 'gh auth login'"

# Resolve the item number (and repo, if given a URL).
case $ref in
  *://github.com/*/pull/*|*://github.com/*/issues/*)
    [ -n "$repo" ] || repo=$(echo "$ref" | sed -E 's#.*://github.com/([^/]+/[^/]+)/.*#\1#')
    num=$(echo "$ref" | sed -E 's#.*/(pull|issues)/([0-9]+).*#\2#')
    ;;
  *[!0-9]*|'') die "ISSUE_OR_PR must be a number or a github.com issue/PR URL: $ref" ;;
  *) num=$ref ;;
esac
if [ -z "$repo" ]; then
  repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) \
    || die "cannot infer repo from the current directory — pass --repo owner/name"
fi

# One API call resolves existence, issue-vs-PR, and the title. (Every PR is
# an issue to this endpoint; only PRs carry a pull_request key.)
meta=$(gh api "repos/$repo/issues/$num" \
         --jq '(if has("pull_request") then "pr" else "issue" end) + " " + .title') \
  || die "#$num not found in $repo (or no access)"
kind=${meta%% *} title=${meta#* }

workspace=$PWD
ctx_dir=$workspace/.local/sbx-context
ctx_file=$ctx_dir/$kind-$num.md
mkdir -p "$ctx_dir"

echo "==> fetching $kind #$num from $repo: $title"
if [ "$kind" = issue ]; then
  gh issue view "$num" -R "$repo" \
    --json number,title,url,state,author,labels,body,comments --jq '
    "# Issue #\(.number): \(.title)\n\n" +
    "- URL: \(.url)\n- State: \(.state)\n- Author: \(.author.login // "unknown")\n" +
    "- Labels: \(if (.labels|length) == 0 then "(none)" else (.labels|map(.name)|join(", ")) end)\n\n" +
    "## Description\n\n\(if (.body // "") == "" then "(no description)" else .body end)\n\n" +
    "## Comments\n\n" +
    (if (.comments|length) == 0 then "(none)\n"
     else (.comments|map("### \(.author.login // "unknown") — \(.createdAt)\n\n\(.body)\n")|join("\n")) end)
  ' > "$ctx_file"
else
  gh pr view "$num" -R "$repo" \
    --json number,title,url,state,author,labels,body,comments,baseRefName,headRefName,additions,deletions,changedFiles --jq '
    "# PR #\(.number): \(.title)\n\n" +
    "- URL: \(.url)\n- State: \(.state)\n- Author: \(.author.login // "unknown")\n" +
    "- Branch: \(.headRefName) -> \(.baseRefName)\n" +
    "- Size: \(.changedFiles) files changed, +\(.additions) -\(.deletions)\n" +
    "- Labels: \(if (.labels|length) == 0 then "(none)" else (.labels|map(.name)|join(", ")) end)\n\n" +
    "## Description\n\n\(if (.body // "") == "" then "(no description)" else .body end)\n\n" +
    "## Comments\n\n" +
    (if (.comments|length) == 0 then "(none)\n"
     else (.comments|map("### \(.author.login // "unknown") — \(.createdAt)\n\n\(.body)\n")|join("\n")) end)
  ' > "$ctx_file"
  {
    printf '\n## Diff stat\n\n```\n'
    gh api --paginate "repos/$repo/pulls/$num/files" \
      --jq '.[] | "\(.filename) | +\(.additions) -\(.deletions) (\(.status))"' \
      || echo "(diff stat unavailable)"
    printf '```\n'
  } >> "$ctx_file"
fi
echo "==> context written to $ctx_file"

case $kind in
  issue) kind_label=issue extras= ;;
  pr)    kind_label='pull request' extras=', diff stat' ;;
esac
prompt="You are working on GitHub $kind_label #$num in $repo: \"$title\".

The full $kind_label content (description, labels, comments$extras) is saved at:
  $ctx_file
(In clone mode that path is the read-only host mount, not your working clone.)

Read that file first, then address the $kind_label: understand the request, implement the fix or change it asks for (for a pull request, act on the feedback it contains), and verify your work before finishing."

# Repo-baked templates need --no-share-skills so the shared store does not
# shadow the baked skills (see README); other agents use sbx's stock image.
template=
case $agent in
  claude) template=docker.io/navcf/sandbox-templates:claude-code ;;
  codex)  template=docker.io/navcf/sandbox-templates:codex ;;
  cursor) template=docker.io/navcf/sandbox-templates:cursor-agent ;;
esac
for arg in "$@"; do
  case $arg in
    -t|--template|--template=*) template= ;;  # user override wins
    --clone) clone= ;;                        # already passed, don't duplicate
  esac
done

# Default extra mounts (positional, after the workspace; extra workspaces
# mount at their host-absolute path). Each is skipped silently when absent:
# the Notes dir the baked instructions write plans to, and the dedicated
# GitHub SSH key dir consumed by setup-ssh.sh (read-only).
notes=${SBX_ISSUE_NOTES_DIR-/Users/nav/Documents/Notes}
set -- "$@" "$agent" "$workspace"
[ -n "$notes" ] && [ -d "$notes" ] && set -- "$@" "$notes"
[ -d "$HOME/.ssh/sandbox" ] && set -- "$@" "$HOME/.ssh/sandbox:ro"
set -- "$@" -- "$prompt"
[ -z "$template" ] || set -- --no-share-skills -t "$template" "$@"
[ -z "$clone" ] || set -- --clone "$@"
set -- run --name "$agent-$num" "$@"
echo "==> sbx $*" | head -c 300; echo
exec sbx "$@"
