#!/usr/bin/env sh
# nav-skills — deliver and manage the git-backed skill set inside a sandbox.
#
# Skills are committed content in a private repo (navcf/nav-skills), NOT baked
# per-image. The image bakes a clone as an offline floor; every agent launch
# fast-forwards it and re-materializes it into the agent's skills dir. Changing
# a skill therefore needs a push, not a rebuild.
#
# Why a clone plus a materialize step, rather than cloning straight over the
# skills dir: Codex ships its own built-ins into ~/.codex/skills/.system, so the
# skills dir is not exclusively ours. One neutral clone serves all three agents,
# and materializing copies only the entries git tracks — anything else in the
# target (vendor built-ins, a skill an agent wrote) is never touched.
#
# Git is the manifest. Removals are computed by diffing the top-level entry list
# across the fast-forward, so no state file has to be kept in sync.
#
# The repo is PRIVATE, so fetching needs the host-mounted GitHub deploy key that
# setup-ssh.sh provisions (the shims run it first) plus `github.com:22` in the
# sbx policy. Without either, sync falls back to the clone baked into the image:
# an older skill set, not an empty one. The image gets that clone through a
# BuildKit named build context, never by cloning — a credential must never end
# up in a layer.
#
# Environment:
#   NAV_SKILLS_REPO  clone source          (default git@github.com:navcf/nav-skills.git)
#   NAV_SKILLS_REF   branch or tag         (default main)
#   NAV_SKILLS_HOME  clone location        (default ~/.local/share/nav-skills)
#   NAV_SKILLS_DIR   materialize target    (default: the agent's global skills dir)
#
# Usage:
#   nav-skills sync [--force]   fetch, fast-forward, materialize  (run by the shims)
#   nav-skills materialize      copy the clone into the skills dir, no network
#   nav-skills status           clone ref, target, counts, local edits
#   nav-skills list             skills grouped by category, with invocation mode
#   nav-skills doctor           lint the skill set for discovery/consistency bugs
#   nav-skills new <name>       scaffold a skill with correct per-agent frontmatter
#   nav-skills harvest          package local edits as a patch for review
#
# Never fatal by design: a failed sync leaves the baked snapshot in place and
# exits non-zero with a warning, so a launch shim can ignore it.
set -u

REPO=${NAV_SKILLS_REPO:-git@github.com:navcf/nav-skills.git}
REF=${NAV_SKILLS_REF:-main}
HOME_DIR=${NAV_SKILLS_HOME:-$HOME/.local/share/nav-skills}

warn() { echo "nav-skills: $*" >&2; }
die() { warn "$*"; exit 1; }

# ── target resolution ────────────────────────────────────────────────────────
# One sandbox runs one agent, so exactly one of these normally exists. The order
# encodes the project's agent priority: claude, then codex, then cursor.
resolve_target() {
  if [ -n "${NAV_SKILLS_DIR:-}" ]; then
    echo "$NAV_SKILLS_DIR"
    return 0
  fi
  for d in "$HOME/.claude/skills" "$HOME/.codex/skills" "$HOME/.cursor/skills"; do
    [ -d "$d" ] && { echo "$d"; return 0; }
  done
  return 1
}

# Claude is the only agent that loads a directory carrying .claude-plugin/ as a
# plugin; for the others such a directory is dead weight in the skills listing.
target_is_claude() {
  case "$1" in *"/.claude/skills") return 0 ;; *) return 1 ;; esac
}

# ── the entries git owns ─────────────────────────────────────────────────────
# A tracked top-level directory is ours to materialize when it is a skill (has
# SKILL.md) or a Claude plugin (has .claude-plugin/). That deliberately excludes
# the repo's own README/LICENSE/VENDORING, which must not land in a skills dir.
owned_entries() {
  tree=$1 target=$2
  git -C "$HOME_DIR" ls-tree --name-only "$tree" | while read -r entry; do
    if git -C "$HOME_DIR" cat-file -e "$tree:$entry/SKILL.md" 2>/dev/null; then
      echo "$entry"
    elif git -C "$HOME_DIR" cat-file -e "$tree:$entry/.claude-plugin/plugin.json" 2>/dev/null; then
      target_is_claude "$target" && echo "$entry"
    fi
  done
}

# Local edits = work in the target that a materialize would destroy. The clone
# itself is never edited in place, so this is the only meaningful dirty state.
#
# An entry MISSING from the target is deliberately not an edit: a fresh or
# partially-materialized target (a new agent's skills dir, a wiped one) has
# nothing to lose, and treating it as dirty would make sync refuse to do the one
# job it exists for.
local_edits() {
  target=$1
  owned_entries HEAD "$target" | while read -r entry; do
    [ -e "$target/$entry" ] || continue
    diff -rq "$HOME_DIR/$entry" "$target/$entry" >/dev/null 2>&1 || echo "M $entry"
  done
  # Skill directories an agent authored in the sandbox: present in the target,
  # unknown to git. Worth harvesting rather than silently discarding.
  [ -d "$target" ] || return 0
  for d in "$target"/*/; do
    [ -d "$d" ] || continue
    entry=$(basename "$d")
    [ -f "$d/SKILL.md" ] || continue
    [ -e "$HOME_DIR/$entry" ] && continue
    # Vendor built-ins (Codex's .system, cursor's own) never start with a dot
    # here because the glob skips them, but skip anything git could never own.
    echo "? $entry (new in sandbox)"
  done
}

# ── materialize ──────────────────────────────────────────────────────────────
# Copy the tracked entries of the clone into the target. Purely local: no
# network, so it is also the build-time path (see the Dockerfile), where the
# private repo cannot be reached — a key must never be baked into a layer.
#
# $1 is the tree the target currently reflects, or empty when it reflects
# nothing yet; entries that tree had and HEAD does not are removals.
materialize() {
  old_tree=$1 target=$2

  removed=0
  if [ -n "$old_tree" ]; then
    for entry in $(owned_entries "$old_tree" "$target"); do
      if ! git -C "$HOME_DIR" cat-file -e "HEAD:$entry" 2>/dev/null; then
        rm -rf "$target/$entry" && removed=$((removed + 1))
      fi
    done
  fi

  count=0
  for entry in $(owned_entries HEAD "$target"); do
    rm -rf "$target/$entry"
    cp -a "$HOME_DIR/$entry" "$target/$entry" || warn "failed to copy $entry"
    count=$((count + 1))
  done

  msg="nav-skills: $count skills in $target at $(git -C "$HOME_DIR" rev-parse --short HEAD)"
  [ "$removed" -gt 0 ] && msg="$msg, $removed removed"
  echo "$msg"

  # Materializing nothing is almost always a layout mistake, not an empty repo:
  # skills must sit one level deep at the repo root. Without this it fails
  # silently and the image or sandbox ends up with no skills at all.
  if [ "$count" -eq 0 ]; then
    warn "no skills found at the root of $REPO — discovery is one level deep,"
    warn "so each skill needs to be <repo>/<name>/SKILL.md"
    return 1
  fi
}

# ── verbs ────────────────────────────────────────────────────────────────────
# Build-time and offline path: materialize whatever the clone already holds,
# without touching the network. The image bakes the clone via a BuildKit named
# build context rather than cloning, because the repo is private and a
# credential must never end up in a layer.
cmd_materialize() {
  target=$(resolve_target) || die "no skills dir found; set NAV_SKILLS_DIR"
  [ -d "$HOME_DIR/.git" ] || die "no clone at $HOME_DIR — nothing to materialize"
  mkdir -p "$target" || die "cannot create $target"
  materialize "" "$target"
}

cmd_sync() {
  force=0
  [ "${1:-}" = "--force" ] && force=1

  target=$(resolve_target) || die "no skills dir found; set NAV_SKILLS_DIR"
  mkdir -p "$target" || die "cannot create $target"

  if [ ! -d "$HOME_DIR/.git" ]; then
    # No baked clone (or it was removed). Needs credentials for the private
    # repo: the shims run setup-ssh.sh first, so a mounted deploy key is
    # already in place by now. Without one this fails and the caller keeps
    # whatever the target already has.
    echo "nav-skills: cloning $REPO ($REF)"
    rm -rf "$HOME_DIR"
    mkdir -p "$(dirname "$HOME_DIR")"
    git clone --quiet --depth 1 --branch "$REF" "$REPO" "$HOME_DIR" \
      || { warn "clone failed — leaving $target as-is."
           warn "the repo is private: a GitHub deploy key must be mounted (see README"
           warn "'GitHub over SSH'), and github.com:22 allowed in the sbx policy"
           return 1; }
    materialize "" "$target"
    return
  fi

  if [ "$force" -eq 0 ] && [ -n "$(local_edits "$target")" ]; then
    warn "local edits in $target — refusing to overwrite:"
    local_edits "$target" | sed 's/^/  /' >&2
    warn "run 'nav-skills harvest' to package them, or 'sync --force' to discard"
    return 1
  fi

  old_tree=$(git -C "$HOME_DIR" rev-parse HEAD)
  if git -C "$HOME_DIR" fetch --depth 1 origin "$REF" --quiet 2>/dev/null; then
    # Fast-forward only: never rewrite or discard history we did not fetch.
    git -C "$HOME_DIR" merge --ff-only FETCH_HEAD --quiet 2>/dev/null \
      || git -C "$HOME_DIR" reset --hard FETCH_HEAD --quiet 2>/dev/null \
      || warn "could not advance to FETCH_HEAD"
  else
    # Offline, or no credential for the private repo. The baked clone is still
    # a perfectly good skill set, just possibly an older one — materialize it
    # and say so, rather than failing the launch.
    warn "fetch failed — using the baked snapshot at $(git -C "$HOME_DIR" rev-parse --short HEAD)"
  fi

  materialize "$old_tree" "$target"
}

cmd_status() {
  target=$(resolve_target) || die "no skills dir found; set NAV_SKILLS_DIR"
  if [ ! -d "$HOME_DIR/.git" ]; then
    echo "clone:  ABSENT ($HOME_DIR) — run 'nav-skills sync'"
  else
    echo "clone:  $HOME_DIR"
    echo "ref:    $REF at $(git -C "$HOME_DIR" rev-parse --short HEAD)"
  fi
  echo "target: $target"
  echo "skills: $(owned_entries HEAD "$target" 2>/dev/null | wc -l | tr -d ' ') tracked"
  edits=$(local_edits "$target" 2>/dev/null)
  if [ -n "$edits" ]; then
    echo "edits:"
    echo "$edits" | sed 's/^/  /'
  else
    echo "edits:  none"
  fi
}

# Read one frontmatter scalar out of a SKILL.md. Frontmatter only — a matching
# line in the body must not be picked up.
fm_get() {
  awk -v key="$2" '
    NR == 1 && $0 == "---" { infm = 1; next }
    infm && $0 == "---" { exit }
    infm {
      # Top-level "key: value", or a two-space-indented key under metadata:.
      if (match($0, "^ *" key ": *")) {
        v = substr($0, RSTART + RLENGTH)
        gsub(/^["'"'"']|["'"'"']$/, "", v)
        print v
        exit
      }
    }
  ' "$1"
}

cmd_list() {
  target=$(resolve_target) || die "no skills dir found; set NAV_SKILLS_DIR"
  [ -d "$HOME_DIR/.git" ] || die "no clone at $HOME_DIR — run 'nav-skills sync'"
  for entry in $(owned_entries HEAD "$target"); do
    sk="$HOME_DIR/$entry/SKILL.md"
    [ -f "$sk" ] || continue
    printf '%s\t%s\t%s\t%s\n' \
      "$(fm_get "$sk" category)" "$entry" \
      "$(fm_get "$sk" invocation)" "$(fm_get "$sk" source)"
  done | sort | awk -F'\t' '
    $1 != last { printf "\n%s\n", ($1 == "" ? "(uncategorised)" : $1); last = $1 }
    { printf "  %-32s %-6s %s\n", $2, ($3 == "" ? "both" : $3), $4 }
  '
}

cmd_doctor() {
  root=${1:-$HOME_DIR}
  [ -d "$root" ] || die "no such directory: $root"
  fail=0
  for d in "$root"/*/; do
    [ -d "$d" ] || continue
    entry=$(basename "$d")
    [ -d "$d/.claude-plugin" ] && continue
    sk="$d/SKILL.md"
    if [ ! -f "$sk" ]; then
      # A directory with no SKILL.md is invisible to every agent — usually a
      # skill nested one level too deep, which discovery does not reach.
      if find "$d" -mindepth 2 -name SKILL.md -print -quit 2>/dev/null | grep -q .; then
        warn "$entry: SKILL.md is nested too deep — discovery is one level only"
        fail=1
      fi
      continue
    fi

    name=$(fm_get "$sk" name)
    [ -n "$name" ] && [ "$name" != "$entry" ] && {
      warn "$entry: frontmatter name '$name' does not match directory"; fail=1; }
    [ -z "$(fm_get "$sk" description)" ] && {
      warn "$entry: no description — the model cannot know when to use it"; fail=1; }

    # metadata.invocation is authoritative; the per-agent fields must agree.
    inv=$(fm_get "$sk" invocation)
    dmi=$(fm_get "$sk" disable-model-invocation)
    uinv=$(fm_get "$sk" user-invocable)
    policy=
    [ -f "$d/agents/openai.yaml" ] &&
      policy=$(awk '/allow_implicit_invocation:/ {print $2; exit}' "$d/agents/openai.yaml")

    case "${inv:-both}" in
      user)
        case "$dmi" in true|yes|on|1) ;; *)
          warn "$entry: invocation=user but disable-model-invocation is not set"; fail=1 ;;
        esac
        [ -n "$policy" ] && [ "$policy" != "false" ] && {
          warn "$entry: invocation=user but openai.yaml allows implicit invocation"; fail=1; }
        ;;
      model)
        case "$uinv" in false|no|off|0) ;; *)
          warn "$entry: invocation=model but user-invocable is not false"; fail=1 ;;
        esac
        ;;
      both)
        case "$dmi" in true|yes|on|1)
          warn "$entry: disable-model-invocation set but invocation=both"; fail=1 ;;
        esac
        [ "$policy" = "false" ] && {
          warn "$entry: openai.yaml denies implicit invocation but invocation=both"; fail=1; }
        ;;
      *) warn "$entry: unknown metadata.invocation '$inv' (want user|model|both)"; fail=1 ;;
    esac
  done
  [ "$fail" -eq 0 ] && echo "nav-skills: doctor found no problems in $root"
  return $fail
}

cmd_new() {
  name=${1:-}
  [ -n "$name" ] || die "usage: nav-skills new <skill-name> [user|model|both]"
  mode=${2:-both}
  echo "$name" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?$' \
    || die "name must be lowercase letters, digits and hyphens"
  [ -d "$HOME_DIR/.git" ] || die "no clone at $HOME_DIR — run 'nav-skills sync'"
  dir="$HOME_DIR/$name"
  [ -e "$dir" ] && die "$name already exists"

  case "$mode" in
    user)  extra='disable-model-invocation: true' ; policy=false ;;
    model) extra='user-invocable: false'          ; policy=true  ;;
    both)  extra=                                 ; policy=true  ;;
    *) die "mode must be user, model or both" ;;
  esac

  mkdir -p "$dir/agents"
  {
    echo '---'
    echo "name: $name"
    echo 'description: TODO — what it does and when to use it, trigger first.'
    [ -n "$extra" ] && echo "$extra"
    echo 'metadata:'
    echo "  invocation: $mode"
    echo '  category: TODO'
    echo '  source: local'
    echo '---'
    echo
    echo "# $name"
    echo
    echo 'TODO — the instructions. Keep it short: once loaded, this stays in'
    echo 'context for the rest of the session.'
  } > "$dir/SKILL.md"
  {
    echo 'interface:'
    echo "  display_name: \"$name\""
    echo '  short_description: "TODO — 25-64 characters"'
    echo 'policy:'
    echo "  allow_implicit_invocation: $policy"
  } > "$dir/agents/openai.yaml"

  echo "nav-skills: created $dir (invocation=$mode)"
  echo "  edit SKILL.md, then 'nav-skills doctor' and 'nav-skills harvest'"
}

cmd_harvest() {
  target=$(resolve_target) || die "no skills dir found; set NAV_SKILLS_DIR"
  [ -d "$HOME_DIR/.git" ] || die "no clone at $HOME_DIR — run 'nav-skills sync'"
  edits=$(local_edits "$target")
  [ -n "$edits" ] || { echo "nav-skills: nothing to harvest"; return 0; }

  # Stage the before/after trees as a/ and b/ and diff them with RELATIVE
  # paths, so the result is a normal `git apply -p1` patch. Diffing the real
  # directories directly would bake absolute sandbox paths into the headers and
  # the patch would not apply in a checkout on the host.
  out="$HOME_DIR/.harvest"
  name="nav-skills-$(git -C "$HOME_DIR" rev-parse --short HEAD).patch"
  rm -rf "$out"
  mkdir -p "$out/a" "$out/b"
  echo "$edits" | while read -r _flag entry _rest; do
    [ -d "$HOME_DIR/$entry" ] && cp -a "$HOME_DIR/$entry" "$out/a/$entry"
    [ -e "$target/$entry" ] && cp -a "$target/$entry" "$out/b/$entry"
  done
  # diff exits 1 when it finds differences, which is the expected case here.
  (cd "$out" && diff -ruN a b > "$name" 2>/dev/null || true)
  rm -rf "$out/a" "$out/b"
  patch="$out/$name"

  echo "nav-skills: harvested to $patch"
  echo
  echo "$edits" | sed 's/^/  /'
  echo
  # Deliberately does not commit or push: the clone has no write credential,
  # and skill changes belong in a reviewed commit on the host.
  echo "Retrieve it on the host with:"
  echo "  sbx cp <sandbox>:$patch ."
  echo "then in a nav-skills checkout:"
  echo "  git apply nav-skills-*.patch && git status"
}

case "${1:-}" in
  sync)        shift; cmd_sync "$@" ;;
  materialize) shift; cmd_materialize "$@" ;;
  status)  shift; cmd_status "$@" ;;
  list)    shift; cmd_list "$@" ;;
  doctor)  shift; cmd_doctor "$@" ;;
  new)     shift; cmd_new "$@" ;;
  harvest) shift; cmd_harvest "$@" ;;
  ''|-h|--help|help)
    sed -n '/^# Usage:/,/^# Never fatal/p' "$0" | sed 's/^# \{0,1\}//;$d'
    ;;
  *) die "unknown command '$1' — try 'nav-skills --help'" ;;
esac
